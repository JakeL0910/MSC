# ---------------------------------------------------------------------------
# Make Spanish Casual — environment variables
# Copy to .env.local for local dev, or set in Vercel Project Settings for prod.
# ---------------------------------------------------------------------------

# Production data store (Upstash Redis). Provision from the Vercel Marketplace
# (Upstash) and these are injected automatically. Without them, the app falls
# back to the JSON files in /data (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (The older Vercel KV names KV_REST_API_URL / KV_REST_API_TOKEN also work.)

# Password for the /admin pages and admin API reads (classes, registrations, stories).
ADMIN_PASSWORD=

# THE GO-LIVE SWITCH. Set to "true" in production to make the site public:
# it turns OFF the private-preview password gate AND opens the site to search
# engines. Leave unset/false to keep the site private. Redeploy after changing.
SITE_PUBLIC=

# Bypass the preview gate WITHOUT allowing search indexing (for private sharing).
GATE_DISABLED=

# Stripe secret key for live donations (optional, when you set up Stripe).
STRIPE_SECRET_KEY=
