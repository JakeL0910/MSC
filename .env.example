# ---------------------------------------------------------------------------
# Make Spanish Casual — environment variables
# Copy to .env.local for local dev, or set in Vercel Project Settings for prod.
# ---------------------------------------------------------------------------

# Production data store (Upstash Redis). Provision from the Vercel Marketplace
# (Upstash) and these are injected automatically. Without them, the app falls
# back to the JSON files in /data (fine for local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (The older Vercel KV names KV_REST_API_URL / KV_REST_API_TOKEN also work.)

# Password for the /admin pages and admin API reads (classes, registrations,
# stories, members, contributions).
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# MEMBERSHIP & PASSWORDLESS SIGN-IN (Phase 2)
# ---------------------------------------------------------------------------
# Secret used to sign member magic-link and session tokens. Set a long random
# value in production. Falls back to ADMIN_PASSWORD, then a dev constant.
AUTH_SECRET=

# Transactional email for the member sign-in link. With a Resend API key the
# link is emailed; without one (local/preview) it's logged to the server console
# and returned by /api/auth/request so you can sign in without email.
RESEND_API_KEY=
MAIL_FROM=MSC <onboarding@resend.dev>

# Absolute site URL used to build magic links and digest links. Optional locally
# (derived from the request); set it in production so links point at the live domain.
NEXT_PUBLIC_SITE_URL=

# Secret for the monthly member digest cron (/api/digest/send). Vercel Cron sends
# this automatically as a Bearer token. Set a long random value in production.
CRON_SECRET=

# THE GO-LIVE SWITCH. Set to "true" in production to make the site public:
# it turns OFF the private-preview password gate AND opens the site to search
# engines. Leave unset/false to keep the site private. Redeploy after changing.
SITE_PUBLIC=

# Bypass the preview gate WITHOUT allowing search indexing (for private sharing).
GATE_DISABLED=

# Stripe secret key for live donations (optional, when you set up Stripe).
STRIPE_SECRET_KEY=
